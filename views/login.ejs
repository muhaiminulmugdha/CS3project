<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="/styles/login.css">
    <title>Login</title>
</head>
<body>
<header>
    <nav>
        <p><a href="/"><span class="bro">Falcon</span><span class="codes">Flow</span></a></p>
    </nav>
</header>
<div class="loginForm">
    <form method="POST" action="/api/v1/users/login" id="login-form">
        <h1>Login</h1>

        <% if (error) { %>
            <div class="error-message">
                ⚠️ <%= error %>
            </div>
        <% } %>

        <div class="inputs">
            <label for="email">Email</label>
            <input required type="email" name="email" id="email" value="<%= email || '' %>"/>
            <label for="password">Password</label>
            <input required type="password" name="password" id="password"/>
        </div>
        <button id="loginBtn">Login</button>
        <p class="fPass">Forgot password?</p>
        <div class="linkToSignUp">
            <p>Don't have an account? </p>
            <a href="/signup">Sign up</a>
        </div>
    </form>
</div>
</body>
</html>