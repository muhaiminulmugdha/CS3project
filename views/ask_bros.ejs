<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="/styles/askbros.css">
    <title>AskBros</title>
</head>
<body>
<header>
    <nav>
        <div class="main-logo">
            <p><a href="/"><span class="bro">Falcon</span><span class="codes">Flow</span></a></p>
        </div>
        <div class="nav-search">
            <input type="text" class="search-bar" placeholder="Search questions...">
        </div>
        <div class="nav-bar">
            <div class="nav-objects"><a href="/ask_bros">ASKBROS</a></div>
            <div class="nav-objects"><a href="/help_bros">HELPBROS</a></div>
            <button class="dark-toggle" onclick="toggleDark()" id="toggleBtn">🌙 Dark</button>
            <a href="/account" class="account-btn">👤 <%= user.username %></a>
            <% if (user.role === 'teacher') { %>
                <a href="/dashboard" class="dashboard-btn">📊 Dashboard</a>
            <% } %>
            <div class="logout"><a href="/logout">LOGOUT</a></div>
        </div>
    </nav>
</header>

<div class="askbrosForm">
    <form method="POST" action="/ask-question" id="bros-form">
        <div class="form-container">
            <div class="askbros-header">
                <h1>AskBros</h1>
            </div>
            <div class="askbros-input">
                <textarea name="ask_question" placeholder="Ask your question..."></textarea>
            </div>
            <div class="askbros-selects">
                <select name="class">
                    <option value="">Select Class</option>
                    <option value="APCSP">APCSP</option>
                    <option value="CS2">CS2</option>
                    <option value="IT2">IT2</option>
                </select>
                <select name="language">
                    <option value="">Select Language</option>
                    <option value="Python">Python</option>
                    <option value="JavaScript">JavaScript</option>
                    <option value="HTML">HTML</option>
                    <option value="CSS">CSS</option>
                    <option value="Java">Java</option>
                    <option value="C++">C++</option>
                    <option value="Other">Other</option>
                </select>
                <input type="text" name="assessment" placeholder="Assessment name (optional)" class="assessment-input"/>
            </div>
            <div class="askbros-button">
                <button type="submit">POST</button>
            </div>
        </div>
    </form>
</div>

<div class="questions-feed">
    <div class="filters">
        <div class="filter-group">
            <span class="filter-label">Class:</span>
            <button class="filter-btn active" onclick="filterQuestions('class', '')">All</button>
            <button class="filter-btn" onclick="filterQuestions('class', 'APCSP')">APCSP</button>
            <button class="filter-btn" onclick="filterQuestions('class', 'CS2')">CS2</button>
            <button class="filter-btn" onclick="filterQuestions('class', 'IT2')">IT2</button>
        </div>
        <div class="filter-group">
            <span class="filter-label">Language:</span>
            <button class="filter-btn active" onclick="filterQuestions('language', '')">All</button>
            <button class="filter-btn" onclick="filterQuestions('language', 'Python')">Python</button>
            <button class="filter-btn" onclick="filterQuestions('language', 'JavaScript')">JavaScript</button>
            <button class="filter-btn" onclick="filterQuestions('language', 'HTML')">HTML</button>
            <button class="filter-btn" onclick="filterQuestions('language', 'CSS')">CSS</button>
            <button class="filter-btn" onclick="filterQuestions('language', 'Java')">Java</button>
            <button class="filter-btn" onclick="filterQuestions('language', 'C++')">C++</button>
        </div>
    </div>

    <p class="feed-label">Recent Questions</p>
    <% if (questions.length === 0) { %>
        <p class="no-questions">No questions yet. Be the first to ask!</p>
    <% } else { %>
        <% questions.forEach(function(q) { %>
            <a href="/question/<%= q._id %>" class="question-card-link" 
               data-class="<%= q.class || '' %>" 
               data-language="<%= q.language || '' %>">
                <div class="question-card">
                    <p class="question-text"><%= q.askedquestions %></p>
                    <div class="question-tags">
                        <% if (q.class) { %><span class="tag class-tag"><%= q.class %></span><% } %>
                        <% if (q.language) { %><span class="tag lang-tag"><%= q.language %></span><% } %>
                        <% if (q.assessment) { %><span class="tag assessment-tag">📝 <%= q.assessment %></span><% } %>
                    </div>
                    <div class="question-meta">
                        <span class="question-date"><%= q.createdAt.toDateString() %></span>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="answer-count"><%= q.answerCount %> answer<%= q.answerCount !== 1 ? 's' : '' %></span>
                            <span class="question-user">👤 <%= q.username %></span>
                        </div>
                    </div>
                </div>
            </a>
        <% }) %>
    <% } %>
</div>

<script>
    function toggleDark() {
        document.body.classList.toggle('dark');
        const btn = document.getElementById('toggleBtn');
        btn.textContent = document.body.classList.contains('dark') ? '☀️ Light' : '🌙 Dark';
        localStorage.setItem('theme', document.body.classList.contains('dark') ? 'dark' : 'light');
    }
    if (localStorage.getItem('theme') === 'dark') {
        document.body.classList.add('dark');
        document.getElementById('toggleBtn').textContent = '☀️ Light';
    }

    // Active filters
    let activeClass = '';
    let activeLanguage = '';

    function filterQuestions(type, value) {
        if (type === 'class') activeClass = value;
        if (type === 'language') activeLanguage = value;

        // Update active buttons
        document.querySelectorAll(`.filter-btn`).forEach(btn => {
            btn.classList.remove('active');
        });
        event.target.classList.add('active');

        // Filter cards
        const cards = document.querySelectorAll('.question-card-link');
        cards.forEach(card => {
            const cardClass = card.dataset.class || '';
            const cardLanguage = card.dataset.language || '';
            const classMatch = activeClass === '' || cardClass === activeClass;
            const languageMatch = activeLanguage === '' || cardLanguage === activeLanguage;
            card.style.display = classMatch && languageMatch ? 'block' : 'none';
        });
    }

    // Live search
    document.querySelector('.search-bar').addEventListener('input', function() {
        const query = this.value.toLowerCase();
        const cards = document.querySelectorAll('.question-card-link');
        cards.forEach(card => {
            const text = card.querySelector('.question-text').textContent.toLowerCase();
            card.style.display = text.includes(query) ? 'block' : 'none';
        });
    });
</script>
</body>
</html>