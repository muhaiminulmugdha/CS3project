<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="/styles/askbros.css">
    <title>AskBros</title>
</head>
<body>
<header>
    <nav>
        <div class="main-logo">
            <p><a href="/"><span class="bro">Falcon</span><span class="codes">Flow</span></a></p>
        </div>
        <div class="nav-search">
            <input type="text" class="search-bar" placeholder="Search questions...">
        </div>
        <div class="nav-bar">
            <div class="nav-objects"><a href="/ask_bros">ASKBROS</a></div>
            <div class="nav-objects"><a href="/help_bros">HELPBROS</a></div>
            <div class="nav-objects"><a href="/leaderboard">🏆 LEADERBOARD</a></div>
            <button class="dark-toggle" onclick="toggleDark()" id="toggleBtn">🌙 Dark</button>
            <a href="/account" class="account-btn">👤 <%= user.username %></a>
            <% if (user.role === 'teacher') { %>
                <a href="/dashboard" class="dashboard-btn">📊 Dashboard</a>
            <% } %>
            <div class="logout"><a href="/logout">LOGOUT</a></div>
        </div>
    </nav>
</header>

<div class="askbrosForm">
    <form method="POST" action="/ask-question" id="bros-form">
        <div class="form-container">
            <div class="askbros-header">
                <h1>AskBros</h1>
            </div>
            <div class="askbros-input">
                <textarea name="ask_question" id="question-input" placeholder="Ask your question..."></textarea>
            </div>

            <!-- AI Similar Questions -->
            <div id="ai-hints" class="ai-hints" style="display: none;">
                <div class="ai-hints-header">
                    🤖 <strong>Similar questions already exist:</strong>
                    <span class="ai-hint-sub">Check if your question is already answered!</span>
                </div>
                <div id="ai-hints-list"></div>
            </div>

            <div class="askbros-selects">
                <select name="class">
                    <option value="">Select Class</option>
                    <option value="APCSP">APCSP</option>
                    <option value="CS2">CS2</option>
                    <option value="IT2">IT2</option>
                </select>
                <select name="language">
                    <option value="">Select Language</option>
                    <option value="Python">Python</option>
                    <option value="JavaScript">JavaScript</option>
                    <option value="HTML">HTML</option>
                    <option value="CSS">CSS</option>
                    <option value="Java">Java</option>
                    <option value="C++">C++</option>
                    <option value="Other">Other</option>
                </select>
                <input type="text" name="assessment" placeholder="Assessment name (optional)" class="assessment-input"/>
            </div>
            <div class="askbros-button">
                <button type="submit">POST</button>
            </div>
        </div>
    </form>
</div>

<div class="questions-feed">
    <div class="filters">
        <div class="filter-group">
            <span class="filter-label">Class:</span>
            <button class="filter-btn active" onclick="filterQuestions('class', '', event)">All</button>
            <button class="filter-btn" onclick="filterQuestions('class', 'APCSP', event)">APCSP</button>
            <button class="filter-btn" onclick="filterQuestions('class', 'CS2', event)">CS2</button>
            <button class="filter-btn" onclick="filterQuestions('class', 'IT2', event)">IT2</button>
        </div>
        <div class="filter-group">
            <span class="filter-label">Language:</span>
            <button class="filter-btn active" onclick="filterQuestions('language', '', event)">All</button>
            <button class="filter-btn" onclick="filterQuestions('language', 'Python', event)">Python</button>
            <button class="filter-btn" onclick="filterQuestions('language', 'JavaScript', event)">JavaScript</button>
            <button class="filter-btn" onclick="filterQuestions('language', 'HTML', event)">HTML</button>
            <button class="filter-btn" onclick="filterQuestions('language', 'CSS', event)">CSS</button>
            <button class="filter-btn" onclick="filterQuestions('language', 'Java', event)">Java</button>
            <button class="filter-btn" onclick="filterQuestions('language', 'C++', event)">C++</button>
        </div>
    </div>

    <p class="feed-label">Recent Questions</p>
    <% if (questions.length === 0) { %>
        <p class="no-questions">No questions yet. Be the first to ask!</p>
    <% } else { %>
        <% questions.forEach(function(q) { %>
            <a href="/question/<%= q._id %>" class="question-card-link"
               data-class="<%= q.class || '' %>"
               data-language="<%= q.language || '' %>">
                <div class="question-card">
                    <p class="question-text"><%= q.askedquestions %></p>
                    <div class="question-tags">
                        <% if (q.class) { %><span class="tag class-tag"><%= q.class %></span><% } %>
                        <% if (q.language) { %><span class="tag lang-tag"><%= q.language %></span><% } %>
                        <% if (q.assessment) { %><span class="tag assessment-tag">📝 <%= q.assessment %></span><% } %>
                    </div>
                    <div class="question-meta">
                        <span class="question-date"><%= q.createdAt.toDateString() %></span>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="answer-count"><%= q.answerCount %> answer<%= q.answerCount !== 1 ? 's' : '' %></span>
                            <a href="/profile/<%= q.username %>" class="username-link" onclick="event.stopPropagation()">👤 <%= q.username %></a>
                        </div>
                    </div>
                </div>
            </a>
        <% }) %>
    <% } %>

    <% if (totalPages > 1) { %>
        <div class="pagination">
            <% if (currentPage > 1) { %>
                <a href="/ask_bros?page=<%= currentPage - 1 %>" class="page-btn">← Prev</a>
            <% } %>
            <% for (let i = 1; i <= totalPages; i++) { %>
                <a href="/ask_bros?page=<%= i %>" class="page-btn <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
            <% } %>
            <% if (currentPage < totalPages) { %>
                <a href="/ask_bros?page=<%= currentPage + 1 %>" class="page-btn">Next →</a>
            <% } %>
        </div>
    <% } %>
</div>

<script>
    function toggleDark() {
        document.body.classList.toggle('dark');
        const btn = document.getElementById('toggleBtn');
        btn.textContent = document.body.classList.contains('dark') ? '☀️ Light' : '🌙 Dark';
        localStorage.setItem('theme', document.body.classList.contains('dark') ? 'dark' : 'light');
    }
    if (localStorage.getItem('theme') === 'dark') {
        document.body.classList.add('dark');
        document.getElementById('toggleBtn').textContent = '☀️ Light';
    }

    let activeClass = '';
    let activeLanguage = '';
    let aiTimeout = null;

    function filterQuestions(type, value, event) {
        if (type === 'class') {
            activeClass = value;
            document.querySelectorAll('.filter-group')[0].querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
        }
        if (type === 'language') {
            activeLanguage = value;
            document.querySelectorAll('.filter-group')[1].querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
        }
        event.target.classList.add('active');

        const cards = document.querySelectorAll('.question-card-link');
        cards.forEach(card => {
            const cardClass = card.dataset.class || '';
            const cardLanguage = card.dataset.language || '';
            const classMatch = activeClass === '' || cardClass === activeClass;
            const languageMatch = activeLanguage === '' || cardLanguage === activeLanguage;
            card.style.display = classMatch && languageMatch ? 'block' : 'none';
        });
    }

    // Live search
    document.querySelector('.search-bar').addEventListener('input', function() {
        const query = this.value.toLowerCase();
        const cards = document.querySelectorAll('.question-card-link');
        cards.forEach(card => {
            const text = card.querySelector('.question-text').textContent.toLowerCase();
            card.style.display = text.includes(query) ? 'block' : 'none';
        });
    });

    // AI hint — triggers after user stops typing for 1.5 seconds
    document.getElementById('question-input').addEventListener('input', function() {
        clearTimeout(aiTimeout);
        const question = this.value.trim();

        if (question.length < 15) {
            document.getElementById('ai-hints').style.display = 'none';
            return;
        }

        aiTimeout = setTimeout(async () => {
            try {
                const response = await fetch('/api/ai/similar-questions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ question })
                });

                const data = await response.json();
                const hintsDiv = document.getElementById('ai-hints');
                const hintsList = document.getElementById('ai-hints-list');

                if (data.similar && data.similar.length > 0) {
                    hintsList.innerHTML = data.similar.map(q => `
                        <a href="/question/${q._id}" class="ai-hint-item" target="_blank">
                            <span class="ai-hint-text">${q.askedquestions}</span>
                            <div class="ai-hint-tags">
                                ${q.class ? `<span class="tag class-tag">${q.class}</span>` : ''}
                                ${q.language ? `<span class="tag lang-tag">${q.language}</span>` : ''}
                            </div>
                        </a>
                    `).join('');
                    hintsDiv.style.display = 'block';
                } else {
                    hintsDiv.style.display = 'none';
                }
            } catch (err) {
                console.error('AI hint error:', err);
            }
        }, 1000);
    });
</script>
</body>
</html>