<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="/styles/askbros.css">
    <title>AskBros</title>
</head>
<body>
<header>
    <nav>
        <div class="main-logo">
            <p><a href="/"><span class="bro">Falcon</span><span class="codes">Flow</span></a></p>
        </div>
        <div class="nav-bar">
            <div class="nav-objects">
                <a href="/ask_bros">ASKBROS</a>
            </div>
            <div class="nav-objects">
                <a href="/help_bros">HELPBROS</a>
            </div>
            <div class="input-search">
                <input type="text" class="search-bar" placeholder="Search">
            </div>
            <div class="logout">
                <a href="/">LOGOUT</a>
            </div>
        </div>
    </nav>
</header>

<div class="askbrosForm">
    <form method="POST" action="/ask-question" id="bros-form">
        <div class="form-container">
            <div class="askbros-header">
                <h1>AskBros</h1>
            </div>
            <div class="askbros-input">
                <textarea name="ask_question" placeholder="Ask your question..."></textarea>
            </div>
            <div class="askbros-button">
                <button type="submit">POST</button>
            </div>
        </div>
    </form>
</div>

<!-- Questions Feed -->
<div class="questions-feed">
    <% if (questions.length === 0) { %>
        <p class="no-questions">No questions yet. Be the first to ask!</p>
    <% } else { %>
        <% questions.forEach(function(q) { %>
            <div class="question-card">
                <p class="question-text"><%= q.askedquestions %></p>
                <span class="question-date"><%= q.createdAt.toDateString() %></span>
            </div>
        <% }) %>
    <% } %>
</div>

</body>
</html>