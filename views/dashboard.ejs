<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <link rel="stylesheet" href="/styles/dashboard.css">
    <title>Teacher Dashboard</title>
</head>
<body>
<header>
    <nav>
        <div class="main-logo">
            <p><a href="/"><span class="bro">Falcon</span><span class="codes">Flow</span></a></p>
        </div>
        <div class="nav-bar">
            <div class="nav-objects"><a href="/ask_bros">ASKBROS</a></div>
            <div class="nav-objects"><a href="/help_bros">HELPBROS</a></div>
            <button class="dark-toggle" onclick="toggleDark()" id="toggleBtn">🌙 Dark</button>
            <a href="/account" class="account-btn">👤 <%= user.username %></a>
            <div class="logout"><a href="/">LOGOUT</a></div>
        </div>
    </nav>
</header>

<div class="dashboard-page">
    <h1 class="dashboard-title">Teacher Dashboard</h1>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <span class="stat-number"><%= users.length %></span>
            <span class="stat-label">Total Users</span>
        </div>
        <div class="stat-card">
            <span class="stat-number"><%= questions.length %></span>
            <span class="stat-label">Total Questions</span>
        </div>
        <div class="stat-card">
            <span class="stat-number"><%= totalAnswers %></span>
            <span class="stat-label">Total Answers</span>
        </div>
        <div class="stat-card">
            <span class="stat-number"><%= users.filter(u => u.banned).length %></span>
            <span class="stat-label">Banned Users</span>
        </div>
    </div>

    <!-- Users -->
    <div class="section">
        <h2>All Users</h2>
        <div class="table-box">
            <table>
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Joined</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(function(u) { %>
                        <tr class="<%= u.banned ? 'banned-row' : '' %>">
                            <td>👤 <%= u.username %></td>
                            <td><%= u.email %></td>
                            <td><span class="role-badge <%= u.role %>"><%= u.role %></span></td>
                            <td><%= u.createdAt.toDateString() %></td>
                            <td><span class="status-badge <%= u.banned ? 'banned' : 'active' %>"><%= u.banned ? 'Banned' : 'Active' %></span></td>
                            <td>
                                <% if (u.role !== 'teacher') { %>
                                    <div style="display: flex; gap: 8px;">
                                        <form method="POST" action="/dashboard/ban/<%= u._id %>">
                                            <button type="submit" class="<%= u.banned ? 'unban-btn' : 'ban-btn' %>">
                                                <%= u.banned ? 'Unban' : 'Ban' %>
                                            </button>
                                        </form>
                                        <form method="POST" action="/dashboard/promote/<%= u._id %>" onsubmit="return confirm('Promote this user to teacher?')">
                                            <button type="submit" class="promote-btn">⬆️ Promote</button>
                                        </form>
                                    </div>
                                <% } else { %>
                                    <span style="font-size: 12px; color: var(--muted);">Teacher</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Questions -->
    <div class="section">
        <h2>All Questions</h2>
        <div class="table-box">
            <table>
                <thead>
                    <tr>
                        <th>Question</th>
                        <th>Asked By</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% questions.forEach(function(q) { %>
                        <tr>
                            <td><%= q.askedquestions %></td>
                            <td>👤 <%= q.username %></td>
                            <td><%= q.createdAt.toDateString() %></td>
                            <td>
                                <form method="POST" action="/dashboard/question/<%= q._id %>/delete" onsubmit="return confirm('Delete this question and all its answers?')">
                                    <button type="submit" class="delete-btn">🗑️ Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function toggleDark() {
        document.body.classList.toggle('dark');
        const btn = document.getElementById('toggleBtn');
        btn.textContent = document.body.classList.contains('dark') ? '☀️ Light' : '🌙 Dark';
        localStorage.setItem('theme', document.body.classList.contains('dark') ? 'dark' : 'light');
    }
    if (localStorage.getItem('theme') === 'dark') {
        document.body.classList.add('dark');
        document.getElementById('toggleBtn').textContent = '☀️ Light';
    }
</script>
</body>
</html>