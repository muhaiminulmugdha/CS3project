<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="/styles/question.css">
    <title>Question</title>
</head>
<body>
<header>
    <nav>
        <div class="main-logo">
            <p><a href="/"><span class="bro">Falcon</span><span class="codes">Flow</span></a></p>
        </div>
        <div class="nav-search">
            <input type="text" class="search-bar" placeholder="Search questions...">
        </div>
        <div class="nav-bar">
            <div class="nav-objects"><a href="/ask_bros">ASKBROS</a></div>
            <div class="nav-objects"><a href="/help_bros">HELPBROS</a></div>
            <button class="dark-toggle" onclick="toggleDark()" id="toggleBtn">🌙 Dark</button>
            <a href="/account" class="account-btn">👤 <%= user.username %></a>
            <% if (user.role === 'teacher') { %>
                <a href="/dashboard" class="dashboard-btn">📊 Dashboard</a>
            <% } %>
            <div class="logout"><a href="/logout">LOGOUT</a></div>
        </div>
    </nav>
</header>

<div class="question-page">

    <a href="/ask_bros" class="back-btn">← Back to AskBros</a>

    <div class="question-box">
        <p class="question-text"><%= question.askedquestions %></p>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
            <span class="question-date"><%= question.createdAt.toDateString() %></span>
            <div style="display: flex; align-items: center; gap: 12px;">
                <span class="question-user">👤 <%= question.username %></span>
                <% if (user.username === question.username || user.role === 'teacher') { %>
                    <div style="display: flex; gap: 8px;">
                        <a href="/question/<%= question._id %>/edit" class="edit-btn">✏️ Edit</a>
                        <form method="POST" action="/question/<%= question._id %>/delete" onsubmit="return confirm('Are you sure you want to delete this question?')">
                            <button type="submit" class="delete-btn">🗑️ Delete</button>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <div class="answers-section">
        <p class="section-label"><%= answers.length %> Answer<%= answers.length !== 1 ? 's' : '' %></p>
        <% if (answers.length === 0) { %>
            <p class="no-answers">No answers yet. Be the first to help!</p>
        <% } else { %>
            <% answers.forEach(function(a) { %>
                <div class="answer-card">
                    <p class="answer-text"><%= a.answer %></p>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span class="answer-date"><%= a.createdAt.toDateString() %></span>
                            <span class="answer-user">👤 <%= a.username %></span>
                        </div>
                        <% if (user.username === a.username || user.role === 'teacher') { %>
                            <div style="display: flex; gap: 8px;">
                                <a href="/answer/<%= a._id %>/edit" class="edit-btn">✏️ Edit</a>
                                <form method="POST" action="/answer/<%= a._id %>/delete" onsubmit="return confirm('Delete this answer?')">
                                    <button type="submit" class="delete-btn">🗑️ Delete</button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>

    <div class="answer-form-box">
        <p class="section-label">Your Answer</p>
        <form method="POST" action="/question/<%= question._id %>/answer">
            <textarea name="answer" placeholder="Write your answer here..."></textarea>
            <button type="submit">POST ANSWER</button>
        </form>
    </div>

</div>

<script>
    function toggleDark() {
        document.body.classList.toggle('dark');
        const btn = document.getElementById('toggleBtn');
        btn.textContent = document.body.classList.contains('dark') ? '☀️ Light' : '🌙 Dark';
        localStorage.setItem('theme', document.body.classList.contains('dark') ? 'dark' : 'light');
    }
    if (localStorage.getItem('theme') === 'dark') {
        document.body.classList.add('dark');
        document.getElementById('toggleBtn').textContent = '☀️ Light';
    }
</script>
</body>
</html>