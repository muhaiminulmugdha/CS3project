<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="/styles/leaderboard.css">
    <title>Leaderboard</title>
</head>
<body>
<header>
    <nav>
        <div class="main-logo">
            <p><a href="/"><span class="bro">Falcon</span><span class="codes">Flow</span></a></p>
        </div>
        <div class="nav-search">
            <input type="text" class="search-bar" placeholder="Search questions...">
        </div>
        <div class="nav-bar">
            <div class="nav-objects"><a href="/ask_bros">ASKBROS</a></div>
            <div class="nav-objects"><a href="/help_bros">HELPBROS</a></div>
            <div class="nav-objects"><a href="/leaderboard">🏆 LEADERBOARD</a></div>
            <button class="dark-toggle" onclick="toggleDark()" id="toggleBtn">🌙 Dark</button>
            <a href="/account" class="account-btn">👤 <%= user.username %></a>
            <% if (user.role === 'teacher') { %>
                <a href="/dashboard" class="dashboard-btn">📊 Dashboard</a>
            <% } %>
            <div class="logout"><a href="/logout">LOGOUT</a></div>
        </div>
    </nav>
</header>

<div class="leaderboard-page">
    <div class="leaderboard-header">
        <h1>🏆 Leaderboard</h1>
        <p class="leaderboard-subtitle">Top contributors in FalconFlow</p>
    </div>

    <!-- Score explanation -->
    <div class="score-info">
        <span>🏅 Score = </span>
        <span class="score-pill">Answer × 10</span>
        <span>+</span>
        <span class="score-pill">Upvote × 5</span>
        <span>+</span>
        <span class="score-pill">Question × 2</span>
    </div>

    <!-- Top 3 podium -->
    <% if (leaderboard.length >= 3) { %>
    <div class="podium">
        <!-- 2nd place -->
        <div class="podium-item second">
            <a href="/profile/<%= leaderboard[1].username %>" class="podium-link">
                <div class="podium-avatar">👤</div>
                <div class="podium-rank">🥈</div>
                <p class="podium-name"><%= leaderboard[1].username %></p>
                <p class="podium-score"><%= leaderboard[1].score %> pts</p>
            </a>
            <div class="podium-block second-block">2</div>
        </div>
        <!-- 1st place -->
        <div class="podium-item first">
            <a href="/profile/<%= leaderboard[0].username %>" class="podium-link">
                <div class="podium-avatar">👤</div>
                <div class="podium-rank">🥇</div>
                <p class="podium-name"><%= leaderboard[0].username %></p>
                <p class="podium-score"><%= leaderboard[0].score %> pts</p>
            </a>
            <div class="podium-block first-block">1</div>
        </div>
        <!-- 3rd place -->
        <div class="podium-item third">
            <a href="/profile/<%= leaderboard[2].username %>" class="podium-link">
                <div class="podium-avatar">👤</div>
                <div class="podium-rank">🥉</div>
                <p class="podium-name"><%= leaderboard[2].username %></p>
                <p class="podium-score"><%= leaderboard[2].score %> pts</p>
            </a>
            <div class="podium-block third-block">3</div>
        </div>
    </div>
    <% } %>

    <!-- Full leaderboard table -->
    <div class="leaderboard-table">
        <div class="table-header">
            <span>Rank</span>
            <span>User</span>
            <span>Answers</span>
            <span>Questions</span>
            <span>Upvotes</span>
            <span>Score</span>
        </div>
        <% leaderboard.forEach(function(u, i) { %>
            <a href="/profile/<%= u.username %>" class="table-row-link">
                <div class="table-row <%= user.username === u.username ? 'my-row' : '' %>">
                    <span class="rank">
                        <% if (i === 0) { %>🥇
                        <% } else if (i === 1) { %>🥈
                        <% } else if (i === 2) { %>🥉
                        <% } else { %>#<%= i + 1 %>
                        <% } %>
                    </span>
                    <span class="lb-username">
                        👤 <%= u.username %>
                        <% if (u.role === 'teacher') { %>
                            <span class="teacher-badge">Teacher</span>
                        <% } %>
                        <% if (user.username === u.username) { %>
                            <span class="you-badge">You</span>
                        <% } %>
                    </span>
                    <span class="lb-stat"><%= u.answerCount %></span>
                    <span class="lb-stat"><%= u.questions %></span>
                    <span class="lb-stat"><%= u.totalUpvotes %></span>
                    <span class="lb-score"><%= u.score %> pts</span>
                </div>
            </a>
        <% }) %>
    </div>
</div>

<script>
    function toggleDark() {
        document.body.classList.toggle('dark');
        const btn = document.getElementById('toggleBtn');
        btn.textContent = document.body.classList.contains('dark') ? '☀️ Light' : '🌙 Dark';
        localStorage.setItem('theme', document.body.classList.contains('dark') ? 'dark' : 'light');
    }
    if (localStorage.getItem('theme') === 'dark') {
        document.body.classList.add('dark');
        document.getElementById('toggleBtn').textContent = '☀️ Light';
    }
</script>
</body>
</html>